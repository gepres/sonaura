{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonaura",
  "version": "1.0.0",
  "identifier": "digital.collie.sonaura",
  "build": {
    "beforeDevCommand": "npx expo start --web --port 8081",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run web:export",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonaura",
        "width": 1200,
        "height": 820,
        "minWidth": 400,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0A0717"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://drive.google.com https://*.googleusercontent.com http://asset.localhost asset:; media-src 'self' blob: http://drive.localhost drive: http://asset.localhost asset:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/sonaura/**"
        ]
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sonaura",
    "shortDescription": "Tu música, tu energía",
    "longDescription": "Reproductor de música que lee una carpeta pública de Google Drive, con favoritos y escucha sin conexión.",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  }
}
