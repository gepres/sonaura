# Carpeta pública de Google Drive con la música (por defecto la del proyecto).
EXPO_PUBLIC_DRIVE_FOLDER_ID=1Bj2CW9jD-rbQwdVeB7ZEOkkI9obYZBMw

# Opcional: API key de Google Drive API v3 (restringida a la app). Sin ella se usa la vista
# pública embebida de Drive, que no necesita key pero es menos robusta con carpetas grandes.
EXPO_PUBLIC_DRIVE_API_KEY=

# Web en el navegador (Netlify): clave de Drive API v3 restringida por dominio (HTTP referrer)
# al de la web. En un navegador, Drive bloquea la vista embebida (sin CORS) y la descarga
# directa (403 cross-site); la API sí sirve listado y audio. Escritorio y móvil no la usan.
# Ponla en .env.local (ignorado por git), no en .env.
EXPO_PUBLIC_DRIVE_WEB_API_KEY=
